<Window x:Class="GDSkinStudio.Views.ItemTextsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GDSkinStudio.Localization"
        Title="{l:Tr LibC_TextsTitle}" Width="680" SizeToContent="Height" MaxHeight="820" MinWidth="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        AutomationProperties.AutomationId="ItemTextsDialog" Background="{StaticResource PageBg}">
    <!-- 消耗品（イリュージョン）の名前と説明文の編集（2026-10-17 機能 SF11）。空欄の欄は既定の文を使う -->
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" AutomationProperties.AutomationId="DialogTitle" />
            <TextBlock Text="{l:Tr LibC_TextsIntro}" TextWrapping="Wrap" Margin="0,0,0,8" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{l:Tr LibC_TextsSetHeader}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{l:Tr LibC_TextsSetEn}" Style="{StaticResource Label}" />
                        <TextBox x:Name="SetEn" MaxLength="64" AutomationProperties.AutomationId="Texts_SetEn" AutomationProperties.Name="{l:Tr LibC_TextsSetEn}" />
                        <TextBlock x:Name="SetEnDefault" Style="{StaticResource Hint}" AutomationProperties.AutomationId="Texts_SetEnDefault" />
                        <TextBlock Text="{l:Tr LibC_TextsSetJa}" Style="{StaticResource Label}" />
                        <TextBox x:Name="SetJa" MaxLength="64" AutomationProperties.AutomationId="Texts_SetJa" AutomationProperties.Name="{l:Tr LibC_TextsSetJa}" />
                        <TextBlock x:Name="SetJaDefault" Style="{StaticResource Hint}" AutomationProperties.AutomationId="Texts_SetJaDefault" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{l:Tr LibC_TextsDescHeader}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{l:Tr LibC_TextsDescEn}" Style="{StaticResource Label}" />
                        <TextBox x:Name="DescEn" MaxLength="400" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="52"
                                 VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="Texts_DescEn" AutomationProperties.Name="{l:Tr LibC_TextsDescEn}" />
                        <TextBlock x:Name="DescEnDefault" Style="{StaticResource Hint}" AutomationProperties.AutomationId="Texts_DescEnDefault" />
                        <TextBlock Text="{l:Tr LibC_TextsDescJa}" Style="{StaticResource Label}" />
                        <TextBox x:Name="DescJa" MaxLength="400" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="52"
                                 VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="Texts_DescJa" AutomationProperties.Name="{l:Tr LibC_TextsDescJa}" />
                        <TextBlock x:Name="DescJaDefault" Style="{StaticResource Hint}" AutomationProperties.AutomationId="Texts_DescJaDefault" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Banner}">
                    <TextBlock Text="{l:Tr LibC_TextsHint}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource Normal}" Content="{l:Tr LibC_TextsClear}" Click="OnClear"
                    ToolTip="{l:Tr LibC_TextsClearTip}" AutomationProperties.AutomationId="Texts_Clear" />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource Normal}" Margin="8,0,0,0" IsCancel="True"
                    Content="{l:Tr Dialog_Cancel}" Click="OnCancel" AutomationProperties.AutomationId="Texts_Cancel" />
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" IsDefault="True"
                    Content="{l:Tr LibC_TextsSave}" Click="OnSave" AutomationProperties.AutomationId="Texts_Save" />
        </DockPanel>
    </Grid>
</Window>
