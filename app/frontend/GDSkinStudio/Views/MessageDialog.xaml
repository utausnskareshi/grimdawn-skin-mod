<Window x:Class="GDSkinStudio.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GDSkinStudio.Localization"
        Width="620" SizeToContent="Height" MaxHeight="820" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.AutomationId="MessageDialog"
        Background="{StaticResource PageBg}">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="IconText" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="520"
                       AutomationProperties.AutomationId="DialogTitle" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,8" AutomationProperties.AutomationId="DialogMessage" />
                <Border x:Name="HintBox" Style="{StaticResource Banner}" Visibility="Collapsed">
                    <TextBlock x:Name="HintText" TextWrapping="Wrap" />
                </Border>
                <ItemsControl x:Name="SectionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8" BorderBrush="{Binding Brush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource Bullet}}" TextWrapping="Wrap" Margin="4,1,0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox x:Name="Check" Visibility="Collapsed" Margin="0,4,0,8" AutomationProperties.AutomationId="DialogCheck">
                    <TextBlock x:Name="CheckText" TextWrapping="Wrap" MaxWidth="540" />
                </CheckBox>
                <Expander x:Name="DetailExpander" Header="{l:Tr Dialog_Details}" Visibility="Collapsed" Margin="0,4,0,0">
                    <TextBox x:Name="DetailText" Style="{StaticResource Mono}" MaxHeight="240" Margin="0,6,0,0" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="LogsButton" DockPanel.Dock="Left" Style="{StaticResource Normal}" Content="{l:Tr Dialog_OpenLogs}"
                    Visibility="Collapsed" Click="OnOpenLogs" AutomationProperties.AutomationId="DialogOpenLogs" />
            <Button x:Name="SecondaryButton" DockPanel.Dock="Right" Style="{StaticResource Normal}" Margin="8,0,0,0" IsCancel="True"
                    Click="OnSecondary" AutomationProperties.AutomationId="DialogSecondary" />
            <Button x:Name="PrimaryButton" DockPanel.Dock="Right" Style="{StaticResource Primary}" IsDefault="True"
                    Click="OnPrimary" AutomationProperties.AutomationId="DialogPrimary" />
        </DockPanel>
    </Grid>
</Window>
