<UserControl x:Class="GDSkinStudio.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GDSkinStudio.Localization">
    <UserControl.Resources>
        <!-- 導入するもの 1 件 -->
        <DataTemplate x:Key="ComponentTemplate">
            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="0,8,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding Optional}" VerticalAlignment="Top" Margin="0,2,0,0"
                              AutomationProperties.AutomationId="{Binding Id, StringFormat=Setup_Select_{0}}" AutomationProperties.Name="{Binding Name}" />
                    <StackPanel Grid.Column="1">
                        <WrapPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0" />
                            <Border CornerRadius="4" Padding="6,1" Margin="0,0,6,0" Background="{StaticResource ChipBg}">
                                <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{StaticResource Muted}" />
                            </Border>
                            <Border CornerRadius="4" Padding="6,1" Background="{StaticResource WarnBg}" Visibility="{Binding HasBadge, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" />
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0">
                            <Run Text="{l:Tr Setup_License}" Foreground="{StaticResource Muted}" /><Run Text="{Binding License, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0">
                            <Run Text="{l:Tr Setup_Source}" Foreground="{StaticResource Muted}" /><Run Text="{Binding SourceName, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding SourceUrl, Mode=OneWay}" Foreground="{StaticResource Accent}" />
                        </TextBlock>
                        <TextBlock Text="{Binding SizeText}" FontSize="12" Margin="0,2,0,0" />
                        <Border Style="{StaticResource Banner}" Background="{StaticResource WarnBg}" Margin="0,6,0,0" Visibility="{Binding HasFlags, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding FlagText}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource WarnText}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="12,0,0,0" MinWidth="150">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding StateStatus, Converter={StaticResource StatusGlyph}}" Foreground="{Binding StateStatus, Converter={StaticResource StatusBrush}}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,6,0" />
                            <TextBlock Text="{Binding StateText}" AutomationProperties.AutomationId="{Binding Id, StringFormat=Setup_State_{0}}" />
                        </StackPanel>
                        <Button Style="{StaticResource Small}" Content="{l:Tr Setup_ShowLicense}" Margin="0,8,0,0" HorizontalAlignment="Right"
                                Command="{Binding DataContext.ShowLicenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                AutomationProperties.AutomationId="{Binding Id, StringFormat=Setup_License_{0}}" />
                        <Button Style="{StaticResource Small}" Content="{l:Tr Setup_OpenSource}" Margin="0,4,0,0" HorizontalAlignment="Right"
                                Command="{Binding DataContext.OpenSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 手順の一覧 -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{l:Tr Setup_Title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{l:Tr Setup_Subtitle}" Style="{StaticResource PageSub}" />
            </StackPanel>
            <Button DockPanel.Dock="Bottom" Style="{StaticResource Normal}" Content="{l:Tr Setup_Skip}" Command="{Binding SkipCommand}" HorizontalAlignment="Left"
                    Margin="0,10,0,0" AutomationProperties.AutomationId="Setup_Skip" />
            <ItemsControl ItemsSource="{Binding Steps}" AutomationProperties.AutomationId="Setup_Steps">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="bd" CornerRadius="6" Padding="10,8" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="glyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xEA3A;" Width="22" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="title" Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="current">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource InfoBg}" />
                                <Setter TargetName="title" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="glyph" Property="Text" Value="&#xE76C;" />
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="done">
                                <Setter TargetName="glyph" Property="Text" Value="&#xE73E;" />
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource OkBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <!-- 各手順の中身 -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource Normal}" Content="{l:Tr Setup_Back}" Command="{Binding BackCommand}" AutomationProperties.AutomationId="Setup_Back" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Primary}" Content="{l:Tr Setup_Next}" Command="{Binding NextCommand}" AutomationProperties.AutomationId="Setup_Next" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="Setup_Scroll">
                <Grid MaxWidth="980" HorizontalAlignment="Left" Margin="0,0,12,12">

                    <!-- 1. 環境の確認 -->
                    <StackPanel Visibility="{Binding CurrentKey, Converter={StaticResource KeyVis}, ConverterParameter=env}">
                        <TextBlock Text="{l:Tr Setup_EnvTitle}" Style="{StaticResource PageTitle}" FontSize="18" />
                        <TextBlock Text="{l:Tr Setup_EnvSub}" Style="{StaticResource PageSub}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding EnvRows}" AutomationProperties.AutomationId="Setup_EnvList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="190" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusGlyph}}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,2,0,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource LabelFg}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource Normal}" Content="{l:Tr Set_Recheck}" Command="{Binding RecheckCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        AutomationProperties.AutomationId="Setup_Recheck" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Banner}">
                            <TextBlock Text="{Binding EnvSummary}" TextWrapping="Wrap" AutomationProperties.AutomationId="Setup_EnvSummary" />
                        </Border>
                    </StackPanel>

                    <!-- 2. 導入するもの・同意 -->
                    <StackPanel Visibility="{Binding CurrentKey, Converter={StaticResource KeyVis}, ConverterParameter=items}">
                        <TextBlock Text="{l:Tr Setup_ItemsTitle}" Style="{StaticResource PageTitle}" FontSize="18" />
                        <TextBlock Text="{l:Tr Setup_ItemsSub}" Style="{StaticResource PageSub}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:Tr Setup_Root}" Style="{StaticResource SectionTitle}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Normal}" Content="{l:Tr Setup_RootDefault}" Command="{Binding DefaultRootCommand}" Margin="6,0,0,0" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Normal}" Content="{l:Tr Gen_Browse}" Command="{Binding BrowseRootCommand}" Margin="6,0,0,0" />
                                    <TextBox Text="{Binding Root, UpdateSourceTrigger=LostFocus}" AutomationProperties.AutomationId="Setup_Root" AutomationProperties.Name="{l:Tr Setup_Root}" />
                                </DockPanel>
                                <TextBlock Text="{l:Tr Setup_RootHint}" Style="{StaticResource Hint}" />
                                <TextBlock Text="{Binding RootProblems}" Foreground="{StaticResource ErrBrush}" TextWrapping="Wrap" Visibility="{Binding RootProblems, Converter={StaticResource NullVis}}" />
                                <Button Style="{StaticResource Normal}" Content="{l:Tr Setup_UseExisting}" Command="{Binding UseExistingCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                        AutomationProperties.AutomationId="Setup_UseExisting" />
                                <TextBlock Text="{l:Tr Setup_UseExistingHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:Tr Setup_RequiredTitle}" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding RequiredComponents}" ItemTemplate="{StaticResource ComponentTemplate}" AutomationProperties.AutomationId="Setup_Required" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:Tr Setup_OptionalTitle}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{l:Tr Setup_OptionalSub}" Style="{StaticResource Hint}" />
                                <ItemsControl ItemsSource="{Binding OptionalComponents}" ItemTemplate="{StaticResource ComponentTemplate}" AutomationProperties.AutomationId="Setup_Optional" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:Tr Setup_ConsentTitle}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding TotalsText}" TextWrapping="Wrap" AutomationProperties.AutomationId="Setup_Totals" />
                                <TextBlock Text="{Binding FreeText}" TextWrapping="Wrap" Margin="0,2,0,6">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DiskOk}" Value="False"><Setter Property="Foreground" Value="{StaticResource ErrBrush}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Style="{StaticResource Banner}" Background="{StaticResource WarnBg}" Visibility="{Binding ClipNeedsConsent, Converter={StaticResource BoolVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{l:Tr Setup_ClipNeeds}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Style="{StaticResource Normal}" Content="{l:Tr Setup_ClipShow}" Command="{Binding ShowClipNoticeCommand}" AutomationProperties.AutomationId="Setup_ClipNotice" />
                                            <TextBlock Text="{l:Tr Setup_ClipAccepted}" Foreground="{StaticResource OkBrush}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                       Visibility="{Binding AcceptClip, Converter={StaticResource BoolVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <CheckBox IsChecked="{Binding AcceptLicenses}" Margin="0,4,0,0" AutomationProperties.AutomationId="Setup_Accept">
                                    <TextBlock Text="{l:Tr Setup_Accept}" TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Text="{l:Tr Setup_AcceptHint}" Style="{StaticResource Hint}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource Primary}" Content="{l:Tr Setup_Start}" Command="{Binding StartCommand}" AutomationProperties.AutomationId="Setup_Start" />
                                    <TextBlock Text="{l:Tr Setup_NoGpuStart}" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding GpuOk, Converter={StaticResource BoolVisInv}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 3. 取得 -->
                    <StackPanel Visibility="{Binding CurrentKey, Converter={StaticResource KeyVis}, ConverterParameter=download}">
                        <TextBlock Text="{l:Tr Setup_DownloadTitle}" Style="{StaticResource PageTitle}" FontSize="18" />
                        <TextBlock Text="{l:Tr Setup_DownloadSub}" Style="{StaticResource PageSub}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding OverallText}" FontWeight="SemiBold" AutomationProperties.AutomationId="Setup_Overall" />
                                <ProgressBar Value="{Binding Overall, Mode=OneWay}" Maximum="100" Height="8" Margin="0,8,0,6" AutomationProperties.AutomationId="Setup_OverallBar" />
                                <TextBlock Text="{Binding CurrentText}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" AutomationProperties.AutomationId="Setup_Current" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource Normal}" Content="{l:Tr Common_Cancel}" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="Setup_Cancel"
                                            Visibility="{Binding Installing, Converter={StaticResource BoolVis}}" />
                                    <Button Style="{StaticResource Primary}" Content="{l:Tr Setup_Retry}" Command="{Binding StartCommand}" AutomationProperties.AutomationId="Setup_Retry"
                                            Visibility="{Binding DownloadFailed, Converter={StaticResource BoolVis}}" />
                                </StackPanel>
                                <TextBlock Text="{l:Tr Setup_RetryHint}" Style="{StaticResource Hint}" Visibility="{Binding DownloadFailed, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <ItemsControl ItemsSource="{Binding Components}" AutomationProperties.AutomationId="Setup_RunList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4" Visibility="{Binding Selected, Converter={StaticResource BoolVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="220" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding RunStatus, Converter={StaticResource StatusGlyph}}" Foreground="{Binding RunStatus, Converter={StaticResource StatusBrush}}"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,0,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{Binding RunText}" AutomationProperties.AutomationId="{Binding Id, StringFormat=Setup_Run_{0}}" />
                                            <TextBlock Grid.Column="3" Text="{Binding RunDetail}" Foreground="{StaticResource Muted}" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:Tr Setup_LogTitle}" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding LogLines}" AutomationProperties.AutomationId="Setup_Log">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 4. 基準メッシュ（B-002） -->
                    <StackPanel Visibility="{Binding CurrentKey, Converter={StaticResource KeyVis}, ConverterParameter=refs}">
                        <TextBlock Text="{l:Tr Setup_RefsTitle}" Style="{StaticResource PageTitle}" FontSize="18" />
                        <TextBlock Text="{l:Tr Setup_RefsSub}" Style="{StaticResource PageSub}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding GameText}" TextWrapping="Wrap" />
                                <Button Style="{StaticResource Small}" Content="{l:Tr Setup_OpenSettings}" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                        Visibility="{Binding GameFound, Converter={StaticResource BoolVisInv}}" />
                                <TextBlock Text="{Binding RefsText}" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold" AutomationProperties.AutomationId="Setup_RefsText" />
                                <ProgressBar Value="{Binding RefsProgress, Mode=OneWay}" Maximum="100" Height="6" Margin="0,6,0,4" Visibility="{Binding RefsBusy, Converter={StaticResource BoolVis}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Style="{StaticResource Primary}" Content="{l:Tr Set_RefsPrepare}" Command="{Binding PrepareRefsCommand}" AutomationProperties.AutomationId="Setup_PrepareRefs" />
                                    <Button Style="{StaticResource Normal}" Content="{l:Tr Common_Cancel}" Command="{Binding CancelRefsCommand}" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{l:Tr Set_RefsHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 5. /basemods の設定（D-022: 書き換えない） -->
                    <StackPanel Visibility="{Binding CurrentKey, Converter={StaticResource KeyVis}, ConverterParameter=basemods}">
                        <TextBlock Text="{l:Tr Setup_BasemodsTitle}" Style="{StaticResource PageTitle}" FontSize="18" />
                        <TextBlock Text="{l:Tr Mod_GuideMessage}" Style="{StaticResource PageSub}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LaunchOk}" Value="True">
                                                        <Setter Property="Text" Value="&#xE73E;" />
                                                        <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding LaunchText}" TextWrapping="Wrap" MaxWidth="860" AutomationProperties.AutomationId="Setup_LaunchText" />
                                </StackPanel>
                                <TextBlock Text="{l:Tr Mod_Guide_Steps}" Style="{StaticResource SectionTitle}" Margin="0,12,0,4" />
                                <TextBlock Text="{l:Tr Setup_Guide1}" TextWrapping="Wrap" Margin="0,2" />
                                <TextBlock Text="{l:Tr Setup_Guide2}" TextWrapping="Wrap" Margin="0,2" />
                                <TextBlock Text="{l:Tr Setup_Guide3}" TextWrapping="Wrap" Margin="0,2" />
                                <TextBlock Text="{l:Tr Mod_Guide_Exclusive}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                <TextBlock Text="{l:Tr Setup_NoRewrite}" Style="{StaticResource Hint}" />
                                <Button Style="{StaticResource Normal}" Content="{l:Tr Set_Recheck}" Command="{Binding RecheckCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        AutomationProperties.AutomationId="Setup_RecheckLaunch" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 完了 -->
                    <StackPanel Visibility="{Binding CurrentKey, Converter={StaticResource KeyVis}, ConverterParameter=done}">
                        <TextBlock Text="{l:Tr Setup_DoneTitle}" Style="{StaticResource PageTitle}" FontSize="18" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding SummaryLines}" AutomationProperties.AutomationId="Setup_Summary">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource Primary}" Content="{l:Tr Setup_Finish}" Command="{Binding FinishCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                        AutomationProperties.AutomationId="Setup_Finish" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
