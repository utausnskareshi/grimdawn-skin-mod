<UserControl x:Class="GDSkinStudio.Views.ModView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GDSkinStudio.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="Mod_Scroll">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="{l:Tr Mod_Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:Tr Mod_Subtitle}" Style="{StaticResource PageSub}" />

            <Border Style="{StaticResource Banner}" Background="{StaticResource WarnBg}" Visibility="{Binding LibraryChanged, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{l:Tr Mod_LibraryChanged}" TextWrapping="Wrap" />
            </Border>
            <!-- 導入先が見つからない（外付けのドライブを外した・設定の打ち間違いなど）。導入の状態を確かめられない（R19B-02） -->
            <Border Style="{StaticResource Banner}" Background="{StaticResource WarnBg}" Visibility="{Binding TargetUnavailable, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{l:Tr ModG19_TargetUnavailableBanner}" TextWrapping="Wrap" AutomationProperties.AutomationId="Mod_TargetUnavailable" />
            </Border>
            <Border Style="{StaticResource Banner}" Background="{StaticResource ErrBg}" Visibility="{Binding GameRunning, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{l:Tr Mod_GameRunningBanner}" TextWrapping="Wrap" Foreground="{StaticResource ErrBrush}" />
            </Border>
            <!-- 導入した後にゲームが更新された（補給官のレコードが MOD と違う。2026-10-17 監査 C84）。変わったティア・何をすればよいか・
                 Steam のビルド番号と、作り直す / 最新のビルドを導入し直すボタン（2026-10-17 機能 SF09） -->
            <Border Style="{StaticResource Banner}" Background="{StaticResource WarnBg}" Visibility="{Binding GameChanged, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding GameChangedText}" TextWrapping="Wrap" AutomationProperties.AutomationId="Mod_GameChanged" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource Small}" Content="{l:Tr UE_RebuildNow}" Command="{Binding BuildCommand}"
                                Visibility="{Binding ShowRebuildButton, Converter={StaticResource BoolVis}}" AutomationProperties.AutomationId="Mod_GameChangedRebuild" />
                        <Button Style="{StaticResource Small}" Content="{l:Tr UE_InstallLatestNow}" Command="{Binding InstallCommand}"
                                Visibility="{Binding ShowInstallLatestButton, Converter={StaticResource BoolVis}}" AutomationProperties.AutomationId="Mod_GameChangedInstall" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 1. MOD の作成 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr Mod_BuildSection}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding BuildText}" TextWrapping="Wrap" AutomationProperties.AutomationId="Mod_BuildText" />
                    <TextBlock Text="{Binding BuildFilesText}" Style="{StaticResource Hint}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource Primary}" Content="{l:Tr Mod_Build}" Command="{Binding BuildCommand}" AutomationProperties.AutomationId="Mod_Build" />
                        <Button Style="{StaticResource Normal}" Content="{l:Tr Mod_Export}" Command="{Binding ExportCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="Mod_Export" />
                        <Button Style="{StaticResource Normal}" Content="{l:Tr Common_Cancel}" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="8" Margin="0,12,0,4" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="{Binding StageText}" Style="{StaticResource Hint}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}" />
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.AutomationId="Mod_Status" />
                </StackPanel>
            </Border>

            <!-- 2. 導入 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr Mod_InstallSection}" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{l:Tr Mod_Target}" Style="{StaticResource Label}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,3">
                            <TextBlock Text="{Binding TargetPath}" TextWrapping="Wrap" AutomationProperties.AutomationId="Mod_Target" />
                            <Border Background="{StaticResource WarnBg}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0"
                                    Visibility="{Binding IsTestTarget, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{l:Tr Mod_TestTarget}" FontSize="12" Foreground="{StaticResource WarnBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{l:Tr Mod_InstallState}" Style="{StaticResource Label}" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,3">
                            <TextBlock Text="{Binding InstalledText}" TextWrapping="Wrap" AutomationProperties.AutomationId="Mod_InstalledText" />
                            <!-- 最新のビルドをまだ導入していない（作成だけではゲームに反映されない。B-039）。上の帯が作り直しを
                                 案内しているときは、作り直してから導入する文（frontend_mod_setup-01） -->
                            <TextBlock Text="{Binding LatestNotInstalledText}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"
                                       Margin="0,4,0,0" Visibility="{Binding LatestNotInstalled, Converter={StaticResource BoolVis}}"
                                       AutomationProperties.AutomationId="Mod_LatestNotInstalled" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="{l:Tr Mod_LaunchOption}" Style="{StaticResource Label}" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,6,0,3">
                            <TextBlock Text="{Binding LaunchText}" TextWrapping="Wrap" />
                            <Button Style="{StaticResource Small}" Content="{l:Tr Mod_Guide}" Command="{Binding GuideCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    AutomationProperties.AutomationId="Mod_Guide" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="{l:Tr Mod_GameLanguageLabel}" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GameLanguageText}" TextWrapping="Wrap" Margin="0,6,0,3" />
                        <!-- ゲームの版（Steam のビルド番号と、MOD を作ったときとの違い。2026-10-17 機能 SF09） -->
                        <TextBlock Grid.Row="4" Text="{l:Tr UE_GameVersionLabel}" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GameVersionText}" TextWrapping="Wrap" Margin="0,6,0,3"
                                   AutomationProperties.AutomationId="Mod_GameVersion" />
                    </Grid>
                    <!-- 導入のボタンは mods フォルダーの表（十数行）の上に置く（表の下では、既定の窓の大きさでスクロールしないと
                         見えず、作成の後に導入していないことに気づけなかった。B-039） -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource Primary}" Content="{l:Tr Mod_Install}" Command="{Binding InstallCommand}" AutomationProperties.AutomationId="Mod_Install" />
                        <Button Style="{StaticResource Normal}" Content="{l:Tr Mod_Uninstall}" Command="{Binding UninstallCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="Mod_Uninstall" />
                        <Button Style="{StaticResource Normal}" Content="{l:Tr Common_Refresh}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="Mod_Refresh" />
                        <Button Style="{StaticResource Normal}" Content="{l:Tr Mod_OpenTarget}" Command="{Binding OpenTargetCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <!-- アンインストールで AI Skin の古い MOD に戻る（残る）こと（2026-10-17 利用者の判断 C126） -->
                    <TextBlock Text="{Binding AiskinNoteText}" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" Margin="0,8,0,0"
                               Visibility="{Binding HasAiskinNote, Converter={StaticResource BoolVis}}" AutomationProperties.AutomationId="Mod_AiskinNote" />
                    <TextBlock Text="{l:Tr Mod_InstallFootnote}" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                    <TextBlock Text="{l:Tr Mod_FilesTitle}" FontWeight="SemiBold" Margin="0,14,0,4" />
                    <DataGrid ItemsSource="{Binding Files}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                              GridLinesVisibility="None" AutomationProperties.AutomationId="Mod_Files" MinHeight="60">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:Tr Mod_ColFile}" Binding="{Binding Name}" Width="140" />
                            <DataGridTextColumn Header="{l:Tr Mod_ColKind}" Binding="{Binding KindText}" Width="170" />
                            <DataGridTextColumn Header="{l:Tr Mod_ColSize}" Binding="{Binding SizeText}" Width="120" />
                            <DataGridTextColumn Header="{l:Tr Mod_ColDetail}" Binding="{Binding Detail}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding BackupsText}" Style="{StaticResource Hint}" Margin="0,8,0,0" AutomationProperties.AutomationId="Mod_Backups" />
                </StackPanel>
            </Border>

            <!-- 3. マルチプレイ用の共有（docs/app_architecture.md 15.2 節） -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Tr Share_Section}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{l:Tr Share_Intro}" TextWrapping="Wrap" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{l:Tr Share_InstalledLabel}" Style="{StaticResource Label}" />
                        <TextBlock Grid.Column="1" Text="{Binding SharedText}" TextWrapping="Wrap" Margin="0,6,0,3" AutomationProperties.AutomationId="Share_InstalledText" />
                        <TextBlock Grid.Row="1" Text="{l:Tr Share_CodeLabel}" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CheckCodeText}" TextWrapping="Wrap" Margin="0,6,0,3" FontFamily="Consolas, Segoe UI"
                                   AutomationProperties.AutomationId="Share_CheckCode" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource Normal}" Content="{l:Tr Share_Export}" Command="{Binding ShareExportCommand}" AutomationProperties.AutomationId="Share_Export" />
                        <Button Style="{StaticResource Primary}" Content="{l:Tr Share_Import}" Command="{Binding ShareImportCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="Share_Import" />
                        <Button Style="{StaticResource Normal}" Content="{l:Tr Share_Restore}" Command="{Binding ShareRestoreCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="Share_Restore" />
                    </StackPanel>
                    <TextBlock Text="{l:Tr Share_Footnote}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <!-- 照合の詳細（ファイルごとの短いコード・相手のコードとの比較。既定は畳む。2026-10-17 機能 SF13） -->
                    <Expander IsExpanded="False" Margin="0,10,0,0" AutomationProperties.AutomationId="Share_DetailExpander"
                              AutomationProperties.Name="{l:Tr UE_CompareExpander}">
                        <Expander.Header>
                            <TextBlock Text="{l:Tr UE_CompareExpander}" FontWeight="SemiBold" />
                        </Expander.Header>
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="{l:Tr UE_CompareIntro}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CompareCodesText}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.AutomationId="Share_CompareCodes" />
                            <DataGrid ItemsSource="{Binding FileCodes}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      CanUserAddRows="False" GridLinesVisibility="None" Margin="0,6,0,0" MinHeight="40"
                                      AutomationProperties.AutomationId="Share_FileCodes" AutomationProperties.Name="{l:Tr UE_FileCodesTable}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:Tr UE_ColFile}" Binding="{Binding Name}" Width="260" />
                                    <DataGridTextColumn Header="{l:Tr UE_ColInstalled}" Binding="{Binding Installed}" Width="150" FontFamily="Consolas" />
                                    <DataGridTextColumn Header="{l:Tr UE_ColLatest}" Binding="{Binding Latest}" Width="150" FontFamily="Consolas" />
                                    <DataGridTextColumn Header="{l:Tr UE_ColNote}" Binding="{Binding Note}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l:Tr UE_FriendCodeLabel}" Style="{StaticResource Label}" />
                                <TextBox Grid.Column="1" Text="{Binding FriendCode, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas, Segoe UI"
                                         VerticalAlignment="Center" MaxLength="40" AutomationProperties.AutomationId="Share_FriendCode"
                                         AutomationProperties.Name="{l:Tr UE_FriendCodeLabel}" />
                                <Button Grid.Column="2" Style="{StaticResource Small}" Content="{l:Tr UE_CompareDo}" Command="{Binding CompareCodeCommand}"
                                        Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Share_CompareCode" />
                            </Grid>
                            <TextBlock Text="{l:Tr UE_FriendCodeHint}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding CompareResultText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                                       AutomationProperties.AutomationId="Share_CompareResult" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
