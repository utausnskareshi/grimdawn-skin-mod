<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:GDSkinStudio.Views">

    <!-- 独自の色。Windows のハイコントラストで起動したときは Views/HighContrast.cs がシステムの色に置き換える（通常はこの固定の配色）。
         置き換えが効くよう、色は直書きせずにこれらのキーを使う。この辞書の中のスタイルからは DynamicResource で参照する
         （同じ辞書の中の StaticResource は辞書を読んだ時点で決まり、後の置き換えが効かないため。他の XAML は StaticResource でよい） -->
    <SolidColorBrush x:Key="PageBg" Color="#F3F5F8" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#DDE2EA" />
    <SolidColorBrush x:Key="NavBg" Color="#1F2937" />
    <SolidColorBrush x:Key="NavFg" Color="#E5E7EB" />
    <SolidColorBrush x:Key="NavSel" Color="#374151" />
    <SolidColorBrush x:Key="NavSelFg" Color="#E5E7EB" />
    <SolidColorBrush x:Key="NavHover" Color="#2B3645" />
    <SolidColorBrush x:Key="NavHoverFg" Color="#E5E7EB" />
    <SolidColorBrush x:Key="NavTitle" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavMuted" Color="#9CA3AF" />
    <SolidColorBrush x:Key="NavStatus" Color="#D1D5DB" />
    <SolidColorBrush x:Key="LabelFg" Color="#374151" />
    <SolidColorBrush x:Key="Muted" Color="#5B6472" />
    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentFg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OkBrush" Color="#15803D" />
    <SolidColorBrush x:Key="WarnBrush" Color="#B45309" />
    <SolidColorBrush x:Key="ErrBrush" Color="#B42318" />
    <SolidColorBrush x:Key="WarnBg" Color="#FFF7E6" />
    <SolidColorBrush x:Key="ErrBg" Color="#FDECEA" />
    <SolidColorBrush x:Key="InfoBg" Color="#EAF1FE" />
    <SolidColorBrush x:Key="ChipBg" Color="#EEF2F7" />
    <SolidColorBrush x:Key="WarnText" Color="#7C2D12" />
    <SolidColorBrush x:Key="SubtleFg" Color="#6B7280" />
    <SolidColorBrush x:Key="ThumbBg" Color="#EEF1F5" />
    <!-- ヘルプの検索で見つかった語の背景と文字 -->
    <SolidColorBrush x:Key="HelpMarkBg" Color="#FDE68A" />
    <SolidColorBrush x:Key="HelpMarkFg" Color="#111827" />

    <!-- 透明な部分を見せる市松模様（入力画像・背景除去後の画像の下に敷く） -->
    <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#F7F8FA">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,2,2" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#DDE1E7">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,1,1" />
                            <RectangleGeometry Rect="1,1,1,1" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <v:BoolToVisibilityConverter x:Key="BoolVis" />
    <v:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True" />
    <v:NullToVisibilityConverter x:Key="NullVis" />
    <v:NullToVisibilityConverter x:Key="NullVisInv" Invert="True" />
    <v:InverseBoolConverter x:Key="InvBool" />
    <v:KeyToVisibilityConverter x:Key="KeyVis" />
    <v:StatusBrushConverter x:Key="StatusBrush" />
    <v:StatusGlyphConverter x:Key="StatusGlyph" />
    <v:BulletConverter x:Key="Bullet" />

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="Banner" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Background" Value="{DynamicResource InfoBg}" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="PageSub" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,0,3" />
        <Setter Property="Foreground" Value="{DynamicResource LabelFg}" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,4" />
    </Style>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="MinWidth" Value="96" />
    </Style>

    <Style x:Key="Normal" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinWidth" Value="72" />
    </Style>

    <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource NavFg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Margin="8,2" Padding="12,10">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavSel}" />
                            <Setter Property="Foreground" Value="{DynamicResource NavSelFg}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource NavHoverFg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
