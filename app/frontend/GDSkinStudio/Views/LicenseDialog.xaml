<Window x:Class="GDSkinStudio.Views.LicenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GDSkinStudio.Localization"
        Width="920" Height="720" MinWidth="600" MinHeight="400" WindowStartupLocation="CenterOwner" Background="{StaticResource PageBg}"
        ShowInTaskbar="False" AutomationProperties.AutomationId="LicenseDialog">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="NameText" Style="{StaticResource PageTitle}" FontSize="18" TextWrapping="Wrap" AutomationProperties.AutomationId="License_Name" />
            <TextBlock x:Name="LicenseText" TextWrapping="Wrap" Margin="0,2,0,0" />
            <TextBlock x:Name="SourceText" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{StaticResource Muted}" />
            <TextBlock x:Name="LinksText" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{StaticResource Muted}" />
            <Border x:Name="FlagsBox" Style="{StaticResource Banner}" Background="{StaticResource WarnBg}" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock x:Name="FlagsText" TextWrapping="Wrap" Foreground="{StaticResource WarnText}" />
            </Border>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource Primary}" Content="{l:Tr Dialog_Close}" Click="OnClose" IsDefault="True" IsCancel="True" AutomationProperties.AutomationId="License_Close" />
        </StackPanel>
        <TextBox x:Name="BodyText" Style="{StaticResource Mono}" Margin="0,10,0,0" AutomationProperties.AutomationId="License_Text" AutomationProperties.Name="{l:Tr License_Body}" />
    </DockPanel>
</Window>
