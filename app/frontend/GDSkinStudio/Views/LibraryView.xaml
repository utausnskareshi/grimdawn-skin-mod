<UserControl x:Class="GDSkinStudio.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GDSkinStudio.Localization"
             xmlns:v="clr-namespace:GDSkinStudio.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{l:Tr Lib_Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:Tr Lib_Subtitle}" Style="{StaticResource PageSub}" />
        </StackPanel>
        <StackPanel Grid.Row="1">
        <Border Style="{StaticResource Banner}" Background="{StaticResource WarnBg}" Visibility="{Binding HasExternal, Converter={StaticResource BoolVis}}"
                AutomationProperties.AutomationId="Lib_ExternalBanner">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Normal}" Content="{l:Tr Lib_ImportButton}" Command="{Binding ImportExternalCommand}"
                        Margin="10,0,0,0" AutomationProperties.AutomationId="Lib_ImportExternal" />
                <TextBlock Text="{Binding ExternalNotice}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="Lib_ExternalNotice" />
            </DockPanel>
        </Border>
        <Border Style="{StaticResource Banner}" Background="{StaticResource WarnBg}" Visibility="{Binding IsVirtualized, Converter={StaticResource BoolVis}}"
                AutomationProperties.AutomationId="Lib_VirtualizedBanner">
            <TextBlock Text="{Binding VirtualizedNotice}" TextWrapping="Wrap" />
        </Border>
        <DockPanel Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Hint}" VerticalAlignment="Center" AutomationProperties.AutomationId="Lib_Summary" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Primary}" Content="{l:Tr Lib_New}" Command="{Binding NewCommand}" AutomationProperties.AutomationId="Lib_New" />
                <Button Style="{StaticResource Normal}" Content="{l:Tr Lib_Regenerate}" Command="{Binding RegenerateCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="Lib_Regenerate" />
                <Button Style="{StaticResource Normal}" Content="{l:Tr Lib_Reconvert}" Command="{Binding ReconvertCommand}" Margin="8,0,0,0"
                        ToolTip="{l:Tr Lib_ReconvertTip}" AutomationProperties.AutomationId="Lib_Reconvert" />
                <Button Style="{StaticResource Normal}" Content="{l:Tr Lib_Delete}" Command="{Binding DeleteCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="Lib_Delete" />
                <Button Style="{StaticResource Normal}" Content="{l:Tr Lib_RebuildMod}" Command="{Binding RebuildModCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="Lib_RebuildMod" />
                <Button Style="{StaticResource Normal}" Content="{l:Tr Common_Refresh}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="Lib_Refresh" />
                <Border Width="1" Background="{StaticResource CardBorder}" Margin="12,4,4,4" />
                <Button Style="{StaticResource Normal}" Content="{l:Tr Lib_ExportPackage}" Command="{Binding ExportPackageCommand}" Margin="8,0,0,0"
                        ToolTip="{l:Tr Lib_ExportPackageTip}" AutomationProperties.AutomationId="Lib_ExportPackage" />
                <Button Style="{StaticResource Normal}" Content="{l:Tr Lib_ImportPackage}" Command="{Binding ImportPackageCommand}" Margin="8,0,0,0"
                        ToolTip="{l:Tr Lib_ImportPackageTip}" AutomationProperties.AutomationId="Lib_ImportPackage" />
            </StackPanel>
        </DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,-4,0,10" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Width="240" Height="8" VerticalAlignment="Center" />
            <TextBlock Text="{Binding BusyText}" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="Lib_BusyText" />
        </StackPanel>
        <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Hint}" Margin="0,-6,0,8" AutomationProperties.AutomationId="Lib_SelectionText"
                   Visibility="{Binding SelectionText, Converter={StaticResource NullVis}}" />
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="4" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- 削除した装備（trash）の一覧と「元に戻す」（機能 SF02） -->
                    <DockPanel Grid.Row="1" Margin="4,4,4,2" LastChildFill="False">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="{l:Tr LibC_Trash}" Command="{Binding TrashCommand}"
                                ToolTip="{l:Tr LibC_TrashTip}" AutomationProperties.AutomationId="Lib_Trash" />
                    </DockPanel>
                    <ListView ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" BorderThickness="0" AutomationProperties.AutomationId="Lib_List"
                              SelectionMode="Extended" SelectionChanged="OnSelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id, StringFormat=Lib_Item_{0}}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="70" Background="{StaticResource ThumbBg}" CornerRadius="4">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0">
                                            <Run Text="{Binding Id, Mode=OneWay}" /><Run Text="{l:Tr Common_Gap}" /><Run Text="{Binding MethodText, Mode=OneWay}" /><Run Text="{l:Tr Common_Gap}" /><Run Text="{Binding CreatedText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding WarningsText}" Style="{StaticResource Hint}" Margin="0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border Background="{StaticResource InfoBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding ModText}" FontSize="12" Foreground="{StaticResource Accent}" />
                                        </Border>
                                        <TextBlock Text="{Binding ConversionText}" Style="{StaticResource Hint}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="{l:Tr Lib_Empty}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20" TextAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Column="2" Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Lib_Edit}" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Tr Gen_NameEn}" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding EditNameEn, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.AutomationId="Lib_EditNameEn"
                                         AutomationProperties.Name="{l:Tr Gen_NameEn}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:Tr Gen_NameJa}" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding EditNameJa, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.AutomationId="Lib_EditNameJa"
                                         AutomationProperties.Name="{l:Tr Gen_NameJa}" />
                            </StackPanel>
                        </Grid>
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Left" Style="{StaticResource Normal}" Content="{l:Tr Lib_Rename}" Command="{Binding RenameCommand}" AutomationProperties.AutomationId="Lib_Rename" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="{l:Tr Lib_OpenFolder}" Command="{Binding OpenFolderCommand}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding Selected.ModelText}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Selected.InputText}" TextWrapping="Wrap" AutomationProperties.AutomationId="Lib_InputText" />
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Selected.RotateText}" TextWrapping="Wrap" AutomationProperties.AutomationId="Lib_RotateText"
                                   Visibility="{Binding Selected.RotateText, Converter={StaticResource NullVis}}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Selected.VerticesText}" />
                        <!-- 消耗品の名前・説明文（空欄なら既定の文。機能 SF11） -->
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="{l:Tr LibC_TextsEdit}" Command="{Binding EditItemTextsCommand}"
                                    ToolTip="{l:Tr LibC_TextsEditTip}" Margin="8,0,0,0" VerticalAlignment="Top" AutomationProperties.AutomationId="Lib_EditTexts" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding Selected.ItemTextsSummary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       VerticalAlignment="Center" AutomationProperties.AutomationId="Lib_TextsSummary" />
                        </DockPanel>
                        <!-- この装備の形のまま、文章で見た目を作り直す（SF10。2026-10-17 U-A3。生成の詳細設定でオンにしたときだけ） -->
                        <DockPanel Margin="0,6,0,0" Visibility="{Binding VariantEnabled, Converter={StaticResource BoolVis}}"
                                   AutomationProperties.AutomationId="Lib_VariantBar">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="{l:Tr UA3_LibButton}" Command="{Binding VariantCommand}"
                                    ToolTip="{l:Tr UA3_LibButtonTip}" Margin="8,0,0,0" VerticalAlignment="Top" AutomationProperties.AutomationId="Lib_Variant" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding VariantHint}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="Lib_VariantHint" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" Margin="0">
                    <v:PreviewControl Items="{Binding PreviewItems}" AutomationProperties.AutomationId="Lib_PreviewControl" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
