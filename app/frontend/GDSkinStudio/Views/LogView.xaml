<UserControl x:Class="GDSkinStudio.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GDSkinStudio.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{l:Tr Log_Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{l:Tr Log_Subtitle}" Style="{StaticResource PageSub}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <CheckBox Content="{l:Tr Log_OnlyProblems}" IsChecked="{Binding OnlyProblems}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Style="{StaticResource Normal}" Content="{l:Tr Common_Refresh}" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="Log_Refresh" />
            <Button Style="{StaticResource Normal}" Content="{l:Tr Log_OpenFolder}" Command="{Binding OpenFolderCommand}" Margin="8,0,0,0" />
            <TextBlock Text="{Binding LogDir}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>
        <TabControl Grid.Row="2">
            <TabItem Header="{l:Tr Log_TabEvents}" AutomationProperties.AutomationId="Log_TabEvents">
                <ListView ItemsSource="{Binding Lines}" FontFamily="Cascadia Mono, Consolas" FontSize="12" AutomationProperties.AutomationId="Log_List"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{StaticResource SubtleFg}" /><Run Text=" " /><Run Text="{Binding Level, Mode=OneWay}">
                                    <Run.Style>
                                        <Style TargetType="Run">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrBrush}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarnBrush}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Run.Style>
                                </Run><Run Text=" [" /><Run Text="{Binding Source, Mode=OneWay}" /><Run Text="] " /><Run Text="{Binding Message, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabItem>
            <TabItem Header="{l:Tr Log_TabBackend}" AutomationProperties.AutomationId="Log_TabBackend">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Style="{StaticResource Small}" Content="{l:Tr Log_Copy}" Command="{Binding CopyCommand}" HorizontalAlignment="Left" Margin="0,4,0,6" />
                    <TextBox Text="{Binding BackendText, Mode=OneWay}" Style="{StaticResource Mono}" AutomationProperties.AutomationId="Log_BackendText"
                             AutomationProperties.Name="{l:Tr Log_TabBackend}" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
